# ─────────────────────────────────────────────────────────────────────────────
# Single-VM deployment. Copy to `.env.vm` ON THE DROPLET and fill in.
#
# RULE, same as .env.example: this file carries VARIABLE NAMES and generator
# commands — NEVER values. `.env.vm` itself is gitignored and must stay that
# way; it holds the seal ring, which is the root of every signature's proof.
#
#   cp .env.vm.example .env.vm && chmod 600 .env.vm && nano .env.vm
#
# Most of these you already have — they are the same values currently set in
# the DigitalOcean App Platform and Vercel dashboards. Copy them across rather
# than minting new ones, with the two exceptions called out below.
# ─────────────────────────────────────────────────────────────────────────────

# ── TLS ──────────────────────────────────────────────────────────────────────
# Where Let's Encrypt sends certificate-expiry warnings.
ACME_EMAIL=

# ── Public URLs ──────────────────────────────────────────────────────────────
# Used to build signing links in emails and the post-signing account link.
# Must be the real https:// origins, not the droplet IP — a link built from an
# IP will not match the certificate and will look like a phishing attempt.
SIGN_APP_URL=
NEXT_PUBLIC_APP_URL=

# ── Database (Neon — UNCHANGED) ──────────────────────────────────────────────
# The RLS-bound application role, NOT the owner. Tenant isolation depends on
# this role having no BYPASSRLS; pointing it at neondb_owner would silently
# disable every tenant boundary in the product.
APP_DATABASE_URL=

# ── The seal ring ────────────────────────────────────────────────────────────
# The Ed25519 keys every completed document is sealed with. Copy EXACTLY from
# the existing deployment — a different ring cannot verify already-sealed
# documents, and the public verification page would start reporting real
# signatures as invalid.
#
# NO SURROUNDING QUOTES. The App Platform UI once turned quotes into part of
# the value and the API died at boot with a JSON SyntaxError; a .env file has
# the same trap.
ESIGN_SEAL_KEYS=

# ── Relay secrets ────────────────────────────────────────────────────────────
# Shared between each front-end app and the API. Same values as today.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SIGN_RELAY_SECRET=
VERIFY_RELAY_SECRET=

# ── Clerk ────────────────────────────────────────────────────────────────────
# The publishable key is BAKED INTO THE BROWSER BUNDLE AT BUILD TIME. Changing
# it requires `up -d --build`, not a restart.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
# Where the worker reports a document it cannot seal. Optional but strongly
# recommended: this is the failure nobody else notices.
ALERT_EMAIL=

# ── Object storage (Cloudflare R2 — UNCHANGED) ───────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Tunables (defaults applied in docker-compose.prod.yml if omitted) ────────
# ESIGN_LINK_TTL_DAYS=14
# REMINDER_AFTER_DAYS=3
# REMINDER_MAX=50
# WEB_CSP_MODE=enforce

# NOT SET, DELIBERATELY: TRUSTED_CLIENT_IP_HEADER.
# Behind Caddy the correct signer address is the rightmost X-Forwarded-For
# entry, which the relay already reads by default. Naming a header here
# switches it to the leftmost — the end a client can forge — and that address
# is printed on Certificates of Completion as evidence.
#
# NOT NEEDED ANY MORE: REDIS_URL. Redis runs on the compose network and the
# URL is set in docker-compose.prod.yml as redis://redis:6379. Do not add an
# Upstash URL back here.
