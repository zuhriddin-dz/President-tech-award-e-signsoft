# Names only — real values live in the untracked .env next to this file.
# Both URLs point at the SAME Neon database, two doors:
#   DATABASE_URL        — DIRECT host (no "-pooler"): migrations only.
#   POOLED_DATABASE_URL — pooled host ("-pooler"): everything at runtime.
DATABASE_URL=
POOLED_DATABASE_URL=
# Runtime role (NEVER neondb_owner — it has BYPASSRLS on Neon and walks through
# every policy). Password: base64url >=24 chars; apply with
#   node scripts/set-app-role-password.mjs
APP_ROLE_PASSWORD=
# Pooled host + docflow_app credentials — what the API actually connects with.
APP_DATABASE_URL=
