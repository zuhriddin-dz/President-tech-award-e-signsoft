// DocFlow — ONE shared-schema database for all tenants.
// Every tenant-owned table carries tenant_id and an RLS policy (added in
// migration SQL — Prisma can't express RLS, so policies live in migrations
// and rls.spec.ts proves them against the real server).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Direct (non-pooler) URL: migrations need an exclusive session.
  // Runtime clients pass the POOLED url via datasourceUrl.
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("membership_role")
}

// A workspace is either one person's (personal) or an organization's (company).
// Same table, same RLS isolation — only billing/features branch on this.
enum TenantKind {
  personal
  company

  @@map("tenant_kind")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  kind        TenantKind   @default(company)
  // Company tenants key on the Clerk org; personal tenants key on the Clerk
  // user. Exactly one is set. Both unique so a person/org maps to one tenant.
  clerkOrgId     String?   @unique @map("clerk_org_id")
  personalUserId String?   @unique @map("personal_user_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("tenants")
}

// Global identity — one row per person, shared across their tenants.
// NOT tenant-scoped by design; tenant-facing reads always go through
// memberships. Clerk linkage columns arrive in Phase 3.
model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  clerkUserId String?      @unique @map("clerk_user_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("users")
}

// Uploaded source PDFs. Bytes live in R2 under tenants/<tenant_id>/…;
// this row is the metadata + pointer.
model Document {
  id          String     @id @default(uuid()) @db.Uuid
  // Defaults to the RLS context in the DB — creates never name a tenant.
  tenantId    String     @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid")) @map("tenant_id") @db.Uuid
  name        String
  contentType String     @map("content_type")
  byteSize    Int        @map("byte_size")
  sha256      String
  storageKey        String             @unique @map("storage_key")
  createdAt         DateTime           @default(now()) @map("created_at")
  templates         Template[]
  signatureRequests SignatureRequest[]

  @@index([tenantId, createdAt])
  @@map("documents")
}

// Lifecycle of one signature request. `completed` is terminal-success;
// `voided` is terminal-cancel. Proof fields fill in on completion (Phase 10).
enum SignatureStatus {
  sent
  viewed
  completed
  voided

  @@map("signature_status")
}

// One document sent to one signer. The source document + field layout are
// SNAPSHOTTED here at send time, so later template edits never change an
// in-flight request. The signing token is stored HASHED only; the raw value
// travels once, in the invite link.
model SignatureRequest {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid")) @map("tenant_id") @db.Uuid
  templateId       String?         @map("template_id") @db.Uuid
  documentId       String          @map("document_id") @db.Uuid
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentName     String          @map("document_name")
  // Snapshot of the template's field layout at send time (contract shape).
  fields           Json
  recipientEmail   String          @map("recipient_email")
  recipientName    String?         @map("recipient_name")
  // sha256 of the signing token — the only form stored, unique for lookup.
  signingTokenHash String          @unique @map("signing_token_hash")
  status           SignatureStatus @default(sent)
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  expiresAt        DateTime        @map("expires_at")
  sentAt           DateTime        @default(now()) @map("sent_at")
  viewedAt         DateTime?       @map("viewed_at")
  consentAt        DateTime?       @map("consent_at")
  completedAt      DateTime?       @map("completed_at")
  // Signer adoption + audit, captured during the ceremony (Phase 9).
  signatureMethod   String?  @map("signature_method")
  signatureImageKey String?  @map("signature_image_key")
  // First-view IP/UA (recorded at view) vs sign-time IP/UA (recorded at submit)
  // — kept separate so the certificate can show both, like DocuSign.
  viewedIp          String?  @map("viewed_ip")
  viewedUserAgent   String?  @map("viewed_user_agent")
  signerIp          String?  @map("signer_ip")
  signerUserAgent   String?  @map("signer_user_agent")
  // Values the signer entered/auto-filled for non-signature fields, keyed by
  // field id — stamped into the PDF at completion.
  fieldValues       Json     @default("{}") @map("field_values")
  // Who sent it (captured at send time, for the certificate's "Sent by").
  senderEmail       String?  @map("sender_email")

  // Completion artifacts (Phase 10): produced by the worker after signing.
  // The seal covers documentHash bound to this request id + completedAt.
  // Set once both parties have been emailed their copy — so a retry that runs
  // after sealing but before/through a mail failure still delivers, instead of
  // seeing the artifacts and reporting success without sending anything.
  completionEmailedAt DateTime? @map("completion_emailed_at")
  signedPdfKey   String? @map("signed_pdf_key")
  certificateKey String? @map("certificate_key")
  documentHash   String? @map("document_hash")
  sealSignature  String? @map("seal_signature")
  sealKid        String? @map("seal_kid")

  @@index([tenantId, status, sentAt])
  @@map("signature_requests")
}

// A reusable signable document: a source Document + a field layout.
// `fields` is a JSON array of placements validated by the contract's
// TemplateFieldSchema. Coordinates are NORMALIZED (0..1 of the page,
// TOP-LEFT origin) so the web editor and the PDF stamper agree without
// any DPI/zoom coupling — the stamper flips y to PDF's bottom-left origin.
// `pageSizes` is the per-page [{w,h}] in PDF points, captured at upload.
model Template {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @default(dbgenerated("(NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid")) @map("tenant_id") @db.Uuid
  name       String
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  pageCount  Int      @map("page_count")
  pageSizes  Json     @map("page_sizes")
  fields     Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@map("templates")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}
