# Names only — real values in the untracked .env.
PORT=
# Clerk backend key (dashboard.clerk.com → API keys). Publishable key lives in apps/web.
CLERK_SECRET_KEY=
# Pooled Neon URL with the docflow_app runtime role — NEVER neondb_owner (BYPASSRLS).
APP_DATABASE_URL=
# R2 (S3 API) — PRIVATE bucket, token scoped to it alone. Docs stream through
# the API; no public URL, no presigned browser access.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# BullMQ backend. Local docker redis in dev; Upstash rediss:// in deploy.
REDIS_URL=
# Ed25519 seal ring JSON: [{"kid":"...","privateKeyPkcs8Pem":"-----BEGIN PRIVATE KEY-----\n...","state":"active"}]
# Long-lived, NEVER deleted, separate from auth keys. Generate a dev key:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const pem=generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).toString();console.log(JSON.stringify([{kid:'dev-seal-1',privateKeyPkcs8Pem:pem,state:'active'}]))"
ESIGN_SEAL_KEYS=
# Email (Resend now; SES later — same EmailSender interface). Until a domain is
# verified, onboarding@resend.dev only delivers to the Resend account's own email.
#
# Once esignsoft.uz is verified in Resend (SPF + DKIM), switch EMAIL_FROM to an
# address AT that domain — e.g. "E-SIGNSOFT <no-reply@esignsoft.uz>". Sending
# from a domain you control is what stops invites landing in spam, and it is
# also what lets you send to anyone rather than only to your own inbox.
RESEND_API_KEY=
EMAIL_FROM="E-SIGNSOFT <onboarding@resend.dev>"
# Where the public signing app serves the ceremony (the invite link's base).
SIGN_APP_URL=
# Signing link lifetime in days.
ESIGN_LINK_TTL_DAYS=
# Narrow /sign/*-only credential shared with apps/sign. >= 32 bytes.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SIGN_RELAY_SECRET=
