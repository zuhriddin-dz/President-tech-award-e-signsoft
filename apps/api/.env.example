# Names only — real values in the untracked .env.
PORT=
# Clerk backend key (dashboard.clerk.com → API keys). Publishable key lives in apps/web.
CLERK_SECRET_KEY=
# Pooled Neon URL with the docflow_app runtime role — NEVER neondb_owner (BYPASSRLS).
APP_DATABASE_URL=
# R2 (S3 API) — PRIVATE bucket, token scoped to it alone. Docs stream through
# the API; no public URL, no presigned browser access.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# BullMQ backend. Local docker redis in dev; Upstash rediss:// in deploy.
REDIS_URL=
# Ed25519 seal ring JSON: [{"kid":"...","privateKeyPkcs8Pem":"-----BEGIN PRIVATE KEY-----\n...","state":"active"}]
# Long-lived, NEVER deleted, separate from auth keys. Generate a dev key:
#   node -e "const{generateKeyPairSync}=require('node:crypto');const pem=generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).toString();console.log(JSON.stringify([{kid:'dev-seal-1',privateKeyPkcs8Pem:pem,state:'active'}]))"
ESIGN_SEAL_KEYS=
