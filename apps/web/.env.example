# Names only — real values in the untracked .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where the NestJS API listens (E-SIGNSOFT convention: 5100).
API_ORIGIN=
# Must equal the API's VERIFY_RELAY_SECRET. Optional; see the note there.
VERIFY_RELAY_SECRET=
# Content-Security-Policy mode for this app: report-only (default) | enforce | off.
# Ships as report-only so the policy can be confirmed against a real Clerk
# session before it can blank the dashboard. Flip to `enforce` once the browser
# console reports no violations. Every OTHER security header is unconditional.
WEB_CSP_MODE=
