# apps/sign is CREDENTIAL-POOR: these two values are ALL it holds. No DB, no
# keys, no Clerk — a full compromise of this box yields the /sign/* relay and
# nothing else.
# Where the NestJS API listens.
MAIN_API_URL=
# The narrow /sign/*-only relay secret (must equal the API's SIGN_RELAY_SECRET).
SIGN_RELAY_SECRET=
# Where the E-SIGNSOFT product lives. PUBLIC by definition — it is only ever used
# to build the "create your free account" link shown after signing, so it is
# not a credential and does not weaken this app's credential-poor posture.
NEXT_PUBLIC_APP_URL=
